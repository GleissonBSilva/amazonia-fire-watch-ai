# 1. Supabase (PostgreSQL + PostGIS & Realtime)
# Obtenha em: https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Backend FastAPI (Local ou Deploy)
VITE_API_URL=http://localhost:8000/api

# 3. NASA Earthdata & FIRMS MAP_KEY (Opcional - Feeds públicos já operam sem chave)
NASA_FIRMS_MAP_KEY=
