# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE • AMAZÔNIA FIRE-WATCH AI
# ==============================================================================

# 1. Supabase (PostgreSQL + PostGIS & Realtime)
# Obtenha em: https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Backend FastAPI (Local ou Deploy)
VITE_API_URL=http://localhost:8000/api

# 3. NASA Earthdata & FIRMS MAP_KEY (Opcional - Feeds públicos já operam sem chave)
NASA_FIRMS_MAP_KEY=

# 4. Vercel AI SDK • Provedores de LLM Central
# Obtenha em: https://aistudio.google.com/app/apikey ou https://platform.openai.com
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# 5. Ferramentas de Busca Web do Agente Autônomo
# Obtenha em: https://tavily.com ou https://serper.dev
TAVILY_API_KEY=
SERPER_API_KEY=

# 6. Text-to-Speech (TTS) • Expressividade Vocal
# OpenAI TTS utiliza OPENAI_API_KEY; ElevenLabs é opcional (fallback nativo Web Speech API)
ELEVENLABS_API_KEY=
VITE_TTS_ENABLED=true
